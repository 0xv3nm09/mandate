PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# This deployment's public origin (e.g. https://203-0-113-10.sslip.io). When set with
# sandbox credentials, the server self-registers its webhook on boot — real PayPal
# events then arrive signature-verified and PAYPAL_WEBHOOK_ID stops being manual.
PUBLIC_BASE_URL=

# Optional — the demo runs fully without an LLM key (deterministic agent mode)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
MANDATE_LLM_MODEL=
# Optional: point the OpenAI-compatible provider anywhere (Vultr Serverless Inference,
# Together, Groq, …). Uses OPENAI_API_KEY as that provider's key. Unset = OpenAI itself.
# OPENAI_BASE_URL=https://api.vultrinference.com/v1

MANDATE_SIGNING_SECRET=change-me-to-a-long-random-string

# Optional hardening for PUBLIC deployments: when set, all state-changing /api
# routes require the `x-mandate-token` header (the web console prompts for it).
# Leave empty for local development.
MANDATE_ADMIN_TOKEN=

PORT=8787

# Invoicer identity on real invoices (defaults to the demo merchant identity)
PAYPAL_INVOICER_NAME=
PAYPAL_INVOICER_EMAIL=
